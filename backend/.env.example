# ─── Scout.io Backend Environment Variables ──────────────────────────────────
# Copy this to .env and fill in your values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Use Supabase "Direct Connection String" from Settings → Database
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# Supabase Project Details (for reference / future use)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PROJECT_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# REDIS (Upstash / Redis Cloud / Local)
# =============================================================================
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
# Qdrant Cloud: https://cloud.qdrant.io → Cluster → "Connect" → REST API
# Endpoint: https://your-cluster-name.region.gcp.cloud.qdrant.io
# API Key: your-qdrant-api-key
QDRANT_URL=https://your-cluster-name.region.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=scout_knowledge

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# =============================================================================
# LLM PROVIDERS (at least one required for AI features)
# =============================================================================
# OpenAI (required for embeddings + chat)
OPENAI_API_KEY=sk-your-openai-key

# Optional: Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Optional: Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4
AZURE_OPENAI_DEPLOYMENT_GPT35=gpt-35-turbo
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional: Google Gemini
GEMINI_API_KEY=

# Optional: Together AI
TOGETHER_API_KEY=

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# =============================================================================
# LLM MODEL SELECTION (per behavior tier)
# =============================================================================
FAST_LLM_MODEL=gpt-3.5-turbo
BALANCED_LLM_MODEL=gpt-4o-mini
ACCURATE_LLM_MODEL=gpt-4o
FALLBACK_MODELS=["claude-3-haiku-20240307", "gemini/gemini-1.5-flash"]

# =============================================================================
# RETRIEVAL & CONTEXT SETTINGS
# =============================================================================
MAX_CONTEXT_TOKENS=4096
MAX_RESPONSE_TOKENS=1024
TOP_K_RETRIEVAL=5

# =============================================================================
# REDIS CACHE TTL SETTINGS
# =============================================================================
REDIS_SESSION_TTL_SECONDS=3600
REDIS_KNOWLEDGE_CACHE_TTL=300
REDIS_OPTIMIZATION_CACHE_TTL=600

# =============================================================================
# CELERY (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/1

# =============================================================================
# CORS ORIGINS (add your frontend domains)
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "https://your-frontend-domain.com"]

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_IP=100/minute
RATE_LIMIT_PER_ORG=1000/minute

# =============================================================================
# FEATURE FLAGS
# =============================================================================
QDRANT_ENABLED=true
LITELLM_ENABLED=true
CELERY_ENABLED=true
PGVECTOR_ENABLED=false
OLLAMA_ENABLED=false

# =============================================================================
# OPTIONAL: OLLAMA (Local LLM)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# =============================================================================
# DEPLOYMENT
# =============================================================================
DEPLOYMENT_PROFILE=full
DEBUG=false