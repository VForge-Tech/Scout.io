# ─── Scout.io Backend Environment Variables ──────────────────────────────────
# 
# SECRET MANAGEMENT WITH HASHICORP VAULT
# 
# In production, all secrets are stored in HashiCorp Vault and fetched at startup.
# This file only contains non-secret configuration and local development defaults.
# 
# VAULT PATH CONVENTION:
#   secret/scout-io/<environment>/<key>
# 
#   Examples:
#     secret/scout-io/production/database_url
#     secret/scout-io/staging/jwt_secret
#     secret/scout-io/development/openai_api_key
# 
# REQUIRED VAULT SECRETS (per environment):
#   - database_url          : PostgreSQL connection string
#   - redis_url             : Redis connection string
#   - qdrant_url            : Qdrant vector DB URL
#   - qdrant_api_key        : Qdrant API key (optional)
#   - jwt_secret            : JWT signing key (min 32 chars, generate with: openssl rand -base64 32)
#   - celery_broker_url     : Celery broker URL (Redis)
#   - celery_result_backend : Celery result backend URL (Redis)
# 
# OPTIONAL VAULT SECRETS:
#   - openai_api_key        : OpenAI API key
#   - anthropic_api_key     : Anthropic/Claude API key
#   - together_api_key      : Together AI API key
#   - gemini_api_key        : Google Gemini API key
#   - azure_openai_api_key  : Azure OpenAI API key
#   - webhook_secret        : Webhook signing secret
# 
# LOCAL DEVELOPMENT:
#   - Set VAULT_ADDR=http://localhost:8200 and VAULT_TOKEN=dev-root-token to use local Vault
#   - Or set environment variables directly (Vault is optional in development)
#   - Run: docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d
# 
# PRODUCTION DEPLOYMENT:
#   1. Provision Vault in production mode (not dev mode)
#   2. Initialize and unseal Vault (see docs/Vault_Production_Setup.md)
#   3. Enable KV v2 secrets engine at path 'secret/'
#   4. Write secrets to secret/scout-io/production/
#   5. Create a Vault policy for the application with read access to secret/scout-io/production/*
#   6. Generate a Vault token with that policy and set VAULT_TOKEN
#   7. Set VAULT_ADDR to your production Vault address
#   8. Set DEPLOYMENT_ENV=production
# 
# VAULT PRODUCTION SETUP GUIDE: docs/Vault_Production_Setup.md

# ─── Non-Secret Configuration ────────────────────────────────────────────────

# Application
APP_NAME=Scout.io
DEBUG=false
DEPLOYMENT_PROFILE=full

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
DEPLOYMENT_ENV=development

# Database (non-secret parts - actual URL comes from Vault)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scout

# Redis (non-secret parts)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Qdrant (non-secret parts)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=scout_knowledge

# JWT (algorithm and expiration only - secret comes from Vault)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM Model Selection (per behavior tier)
FAST_LLM_MODEL=gpt-3.5-turbo
BALANCED_LLM_MODEL=gpt-4o-mini
ACCURATE_LLM_MODEL=gpt-4o
FALLBACK_MODELS=["claude-3-haiku-20240307", "gemini/gemini-1.5-flash"]

# Retrieval & Context Settings
MAX_CONTEXT_TOKENS=4096
MAX_RESPONSE_TOKENS=1024
TOP_K_RETRIEVAL=5

# Redis Cache TTL Settings
REDIS_SESSION_TTL_SECONDS=3600
REDIS_KNOWLEDGE_CACHE_TTL=300
REDIS_OPTIMIZATION_CACHE_TTL=600

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_IP=100/minute
RATE_LIMIT_PER_ORG=1000/minute

# Feature Flags
QDRANT_ENABLED=true
LITELLM_ENABLED=true
CELERY_ENABLED=true
PGVECTOR_ENABLED=false
OLLAMA_ENABLED=false

# Optional: Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2