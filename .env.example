# Scout.io Environment Variables Example

# Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=generate_a_secure_random_key_here

# Network Ports
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=scout_user
POSTGRES_PASSWORD=scout_secure_password
POSTGRES_DB=scout_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scout_user:scout_secure_password@db:5432/scout_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Qdrant Vector DB Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# JWT Configuration
JWT_SECRET_KEY=supersecretjwtkeyplaceholder
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider Keys (LiteLLM configuration)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Monitoring
OPENTELEMETRY_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
