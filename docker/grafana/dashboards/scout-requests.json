{
  "uid": "scout-requests",
  "title": "Scout Requests",
  "tags": ["scout", "http"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate by Endpoint (RPS)",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "scout-prom" },
      "targets": [
        {
          "expr": "sum by (path) (rate(scout_http_requests_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Status Class",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "scout-prom" },
      "targets": [
        {
          "expr": "sum by (status) (rate(scout_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 / P50 Latency by Endpoint",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "scout-prom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(scout_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "p95 {{path}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(scout_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "p50 {{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate per Endpoint",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "scout-prom" },
      "targets": [
        {
          "expr": "sum by (path) (rate(scout_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (path) (rate(scout_http_requests_total[5m])), 1e-6)",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          }
        }
      }
    }
  ]
}